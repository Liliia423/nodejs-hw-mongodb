{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contact Book API",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "Це API для керування контактами з авторизацією, поштою та аватарками.\n"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https:///nodejs-hw-mongodb-lilya.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Авторизація"
    },
    {
      "name": "contacts",
      "description": "Операції з контактами"
    },
    {
      "name": "users",
      "description": "Операції з користувачем"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "contacts"
        ],
        "summary": "Отримати всі контакти користувача",
        "description": "Повертає список контактів з підтримкою пагінації та фільтрації",
        "operationId": "getAllContacts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Номер сторінки (пагінація)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Кількість елементів на сторінці"
          },
          {
            "name": "favorite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Фільтр за улюбленими"
          }
        ],
        "responses": {
          "200": {
            "description": "Список контактів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Список контактів"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "contacts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Contact"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "example": 1
                        },
                        "limit": {
                          "type": "integer",
                          "example": 10
                        },
                        "total": {
                          "type": "integer",
                          "example": 3
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Неавторизований запит",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "contacts"
        ],
        "summary": "Створити новий контакт",
        "description": "Додає новий контакт для авторизованого користувача",
        "operationId": "createContact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewContact"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Контакт успішно створено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "400": {
            "description": "Помилка валідації даних",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Validation failed"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Неавторизований запит",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "message": {
                      "type": "string",
                      "example": "Not authorized"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": [
          "contacts"
        ],
        "summary": "Отримати контакт за ID",
        "operationId": "getContactById",
        "description": "Отримання одного контакту за його унікальним ідентифікатором",
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успішна відповідь",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизований запит"
          },
          "404": {
            "description": "Контакт не знайдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "contacts"
        ],
        "summary": "Оновити контакт за ID",
        "description": "Оновлює контакт за ID авторизованого користувача",
        "operationId": "updateContact",
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Ідентифікатор контакту",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewContact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Контакт оновлено",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "400": {
            "description": "Некоректні дані"
          },
          "401": {
            "description": "Неавторизований запит"
          },
          "404": {
            "description": "Контакт не знайдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "contacts"
        ],
        "summary": "Видалити контакт за ID",
        "description": "Видаляє контакт із бази даних",
        "operationId": "deleteContact",
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Ідентифікатор контакту",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт успішно видалено"
          },
          "401": {
            "description": "Неавторизований запит"
          },
          "404": {
            "description": "Контакт не знайдено"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Реєстрація нового користувача",
        "description": "Створює нового користувача в системі",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUser"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Користувача створено"
          },
          "400": {
            "description": "Помилка валідації або такий email вже існує"
          }
        },
        "security": []
      }
    },
    "/users/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Логін користувача",
        "description": "Авторизує користувача і повертає токен доступу",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успішна авторизація",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserInfo"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Невірні дані для входу"
          }
        },
        "security": []
      }
    },
    "/users/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Вихід користувача",
        "description": "Виходить з системи та анулює токен",
        "operationId": "logoutUser",
        "responses": {
          "204": {
            "description": "Успішний вихід (без тіла відповіді)"
          },
          "401": {
            "description": "Неавторизований запит"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/current": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Отримати поточного користувача",
        "description": "Повертає email і subscription поточного авторизованого користувача",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Дані користувача",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизований запит"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "email",
          "phone",
          "favorite",
          "owner"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "contactType": {
            "type": "string"
          },
          "isFavourite": {
            "type": "boolean"
          },
          "photo": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "ErrorResponse": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "example": "error"
            },
            "code": {
              "type": "integer",
              "example": 401
            },
            "message": {
              "type": "string",
              "example": "Not authorized"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Not authorized"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "NewContact": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phoneNumber",
          "contactType"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "contactType": {
            "type": "string"
          },
          "isFavourite": {
            "type": "boolean"
          }
        }
      },
      "RegisterUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginUser": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "subscription": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "subscription"
        ]
      }
    }
  }
}